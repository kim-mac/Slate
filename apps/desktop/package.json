{
  "name": "@ai-clip-memory/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:frontend",
    "build:bridge": "cargo build --manifest-path src-tauri/Cargo.toml --bin ai-clip-memory-native-host",
    "build:frontend": "tsc -b && vite build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "dev": "vite",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "tauri": "tauri",
    "tauri:build": "tauri build --no-bundle",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-clip-memory/shared": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
