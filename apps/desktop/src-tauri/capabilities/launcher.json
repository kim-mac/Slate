{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "The launcher can only list/copy clips and manage its own lifecycle.",
  "windows": ["launcher"],
  "permissions": [
    "allow-list-clips",
    "allow-copy-clip-content",
    "allow-launcher-ready",
    "allow-hide-launcher",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
