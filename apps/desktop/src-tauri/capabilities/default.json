{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main library can manage clips and inspect launcher availability.",
  "windows": ["main"],
  "permissions": [
    "allow-list-clips",
    "allow-merge-clips",
    "allow-unmerge-group-member",
    "allow-unmerge-group",
    "allow-delete-group-member",
    "allow-delete-group",
    "allow-set-group-pinned",
    "allow-create-clip",
    "allow-update-clip",
    "allow-delete-clip",
    "allow-set-clip-pinned",
    "allow-copy-clip-content",
    "allow-open-clip-source",
    "allow-get-launcher-status",
    "allow-get-autostart-enabled",
    "allow-set-autostart-enabled",
    "core:app:allow-version"
  ]
}
