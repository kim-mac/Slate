{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slate UX Development",
  "identifier": "com.aiclipmemory.desktop.ux-dev",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "launcher",
        {
          "identifier": "ux-dev-identity",
          "windows": ["main"],
          "permissions": ["core:app:allow-name"]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Slate UX Development — isolated test data",
        "width": 1000,
        "height": 700,
        "visible": false
      }
    ]
  },
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } },
  "bundle": { "active": false }
}
