---
import Icon from './Icon.astro';
import { release, windowsDownloads, downloadUrl } from '../data/releases';
---

<div class="windows-options">
  {windowsDownloads.map((id) => {
    const artifact = release.downloads[id];
    const url = downloadUrl(artifact);
    return (
      <article
        class="installer-option"
        data-windows-installer={id}
        aria-labelledby={`${id}-title`}
      >
        <div class="installer-heading">
          <h3 id={`${id}-title`}>{artifact.title}</h3>
          <span class="system-badge" data-recommendation hidden>
            Recommended
          </span>
        </div>
        <p class="installer-description">{artifact.description}</p>
        {url ? (
          <a class="button secondary" href={url} download={artifact.filename}>
            Download {artifact.architecture}
            <Icon name="download" />
          </a>
        ) : (
          <button
            class="button secondary"
            type="button"
            disabled
            title="Download not available yet"
          >
            Download {artifact.architecture}
            <Icon name="download" />
          </button>
        )}
        <div class="fingerprint-row">
          <details class="fingerprint">
            <summary>
              SHA-256 <code>{artifact.sha256.slice(0, 16)}…</code>
            </summary>
            <code class="full-hash">{artifact.sha256}</code>
          </details>
          <button
            class="hash-copy"
            type="button"
            data-copy-hash={artifact.sha256}
            aria-label={`Copy SHA-256 for ${artifact.title}`}
          >
            <Icon name="copy" />
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <span class="copy-status" data-copy-status role="status"></span>
      </article>
    );
  })}
</div>
