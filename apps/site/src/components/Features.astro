---
import FeatureCard from './FeatureCard.astro';
import BrowserCaptureDemo from './BrowserCaptureDemo.astro';
import DesktopCaptureDemo from './DesktopCaptureDemo.astro';
import QuickSearchDemo from './QuickSearchDemo.astro';
import '../styles/feature-demos.css';
---

<section
  class="features shell animated-features"
  aria-label="Save and find things without breaking your flow"
>
  <FeatureCard
    id="capture"
    demo="browser"
    title="Capture from the browser"
    label="Browser capture"
    description="Save useful answers from ChatGPT, Claude, and the web. No copy-pasting."
  >
    <BrowserCaptureDemo />
  </FeatureCard>
  <FeatureCard
    id="desktop-capture"
    demo="desktop"
    title="Capture from your desktop"
    label="Desktop capture"
    description="Select text in any Windows app. Press Ctrl + Alt + Shift + C to save it."
  >
    <DesktopCaptureDemo />
  </FeatureCard>
  <FeatureCard
    id="quick-search"
    demo="search"
    title="Find it instantly"
    label="Quick Search"
    description="Press Ctrl + Shift + Space to find your saved clips without breaking your flow."
  >
    <QuickSearchDemo />
  </FeatureCard>
</section>

<script>
  import { initializeFeatureDemos } from '../scripts/featureDemos';
  const cleanup = initializeFeatureDemos(document, window);
  window.addEventListener('pagehide', cleanup, { once: true });
</script>
