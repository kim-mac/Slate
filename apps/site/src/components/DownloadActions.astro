---
import Icon from './Icon.astro';
import { release, downloadUrl } from '../data/releases';
import { site } from '../data/site';
const windowsReady =
  downloadUrl(release.downloads.windowsX64) ||
  downloadUrl(release.downloads.windowsARM64);
---

<div class="download-actions">
  {windowsReady ? (
    <a class="button primary" href="#download">
      <Icon name="download" /> Download for Windows
    </a>
  ) : (
    <button class="button primary" type="button" disabled>
      <Icon name="download" /> Download for Windows
    </button>
  )}
  <a
    class="button secondary"
    href={site.repositoryUrl}
    target="_blank"
    rel="noopener noreferrer"
    title="Open Slate on GitHub in a new tab"
  >
    <Icon name="star" /> Star on GitHub
  </a>
</div>
<p class="availability">
  {windowsReady
    ? 'Windows 11 · Choose your architecture below'
    : 'Windows 11 · Public downloads coming soon'}
</p>
