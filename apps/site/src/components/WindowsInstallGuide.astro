---
import { release, downloadUrl } from '../data/releases';
const chromeUrl = downloadUrl(release.downloads.chrome);
---

<section
  class="install-guide"
  aria-label="Windows installation steps"
  id="steps"
>
  <ol class="install-steps">
    <li class="install-step">
      <figure class="downloads-art">
        <svg
          data-install-illustration
          viewBox="0 0 360 210"
          role="img"
          aria-label="Illustration of the Slate installer in your Downloads folder"
        >
          <path
            class="folder-back"
            d="M34 64a10 10 0 0 1 10-10h88l18 19h164a10 10 0 0 1 10 10v96H34z"
          />
          <path
            class="folder-front"
            d="M28 91a10 10 0 0 1 10-10h280a10 10 0 0 1 10 10l-10 88a10 10 0 0 1-10 9H47a10 10 0 0 1-10-9z"
          />
          <text class="art-label" x="50" y="109">
            Downloads
          </text>
          <rect
            class="art-surface"
            x="58"
            y="122"
            width="244"
            height="48"
            rx="8"
          />
          <image
            href="/brand/slate-icon.png"
            x="70"
            y="134"
            width="24"
            height="24"
          />
          <text class="art-file" x="104" y="143">
            {release.downloads.windowsX64.filename}
          </text>
          <text class="art-small" x="104" y="158">
            Windows installer
          </text>
          <path class="art-pointer" d="m273 152 3 30 8-8 11-2z" />
          <path class="art-stroke" d="M263 45v22m-7-7 7 7 7-7" />
        </svg>
      </figure>
      <div class="step-copy">
        <h2>
          <span aria-hidden="true">1.</span> Open the installer
        </h2>
        <p>Find Slate in your Downloads folder and open the installer.</p>
      </div>
    </li>
    <li class="install-step">
      <figure class="protection-art">
        <svg
          data-install-illustration
          viewBox="0 0 360 210"
          role="img"
          aria-label="Illustration of a possible SmartScreen warning with More info and Run anyway options"
        >
          <rect
            class="art-surface"
            x="25"
            y="27"
            width="310"
            height="160"
            rx="10"
          />
          <path
            class="shield"
            d="m50 50 12-5 12 5v11c0 10-12 16-12 16S50 71 50 61z"
          />
          <text class="art-label" x="84" y="61">
            Windows protected your PC
          </text>
          <text class="art-small" x="46" y="94">
            Slate installer · Unknown Publisher
          </text>
          <text class="art-label art-underline" x="46" y="120">
            More info
          </text>
          <path class="art-stroke" d="M122 115h32l14 32h21m-6-5 6 5-6 5" />
          <rect
            class="art-button"
            x="201"
            y="132"
            width="112"
            height="32"
            rx="5"
          />
          <text class="art-label" x="218" y="153">
            Run anyway
          </text>
        </svg>
      </figure>
      <div class="step-copy">
        <h2>
          <span aria-hidden="true">2.</span> Windows protection
        </h2>
        <p>
          If Windows shows a protection warning, select{' '}
          <strong>More info</strong>, then <strong>Run anyway</strong> only if
          you trust the installer.
        </p>
      </div>
    </li>
    <li class="install-step">
      <figure class="setup-art">
        <svg
          data-install-illustration
          viewBox="0 0 360 210"
          role="img"
          aria-label="Illustration of the Slate setup completion screen"
        >
          <rect
            class="art-surface"
            x="33"
            y="24"
            width="294"
            height="165"
            rx="10"
          />
          <image
            href="/brand/slate-icon.png"
            x="49"
            y="39"
            width="18"
            height="18"
          />
          <text class="art-label" x="75" y="52">
            Slate Setup
          </text>
          <path class="art-line" d="M33 68h294" />
          <circle class="complete" cx="180" cy="103" r="20" />
          <path class="art-stroke" d="m171 103 6 6 12-13" />
          <text class="art-label" x="180" y="144" text-anchor="middle">
            Ready when you are.
          </text>
          <rect
            class="art-button"
            x="237"
            y="158"
            width="72"
            height="22"
            rx="4"
          />
          <text class="art-small" x="273" y="173" text-anchor="middle">
            Finish
          </text>
        </svg>
      </figure>
      <div class="step-copy">
        <h2>
          <span aria-hidden="true">3.</span> Open Slate
        </h2>
        <p>Complete setup, then open Slate from Start or your desktop.</p>
      </div>
    </li>
    <li class="install-step">
      <figure class="extension-art">
        <svg
          data-install-illustration
          viewBox="0 0 360 210"
          role="img"
          aria-label="Illustration of saving a browser selection to Slate using the optional Chrome extension"
        >
          <rect
            class="art-surface"
            x="25"
            y="27"
            width="310"
            height="160"
            rx="10"
          />
          <path class="art-line" d="M25 58h310" />
          <circle class="art-button" cx="41" cy="43" r="3" />
          <circle class="art-button" cx="53" cy="43" r="3" />
          <circle class="art-button" cx="65" cy="43" r="3" />
          <rect
            class="art-button"
            x="87"
            y="38"
            width="167"
            height="10"
            rx="5"
          />
          <image
            href="/brand/slate-icon.png"
            x="303"
            y="35"
            width="16"
            height="16"
          />
          <text class="art-label" x="43" y="88">
            A useful idea.
          </text>
          <rect
            class="art-button"
            x="43"
            y="101"
            width="125"
            height="17"
            rx="3"
          />
          <text class="art-small" x="49" y="113">
            Keep this for later
          </text>
          <path class="art-line" d="M43 132h112m-112 12h96m-96 12h106" />
          <rect
            class="art-surface extension-popup"
            x="183"
            y="71"
            width="136"
            height="101"
            rx="8"
          />
          <image
            href="/brand/slate-icon.png"
            x="195"
            y="84"
            width="20"
            height="20"
          />
          <text class="art-label" x="223" y="98">
            Slate
          </text>
          <text class="art-label" x="195" y="126">
            Save selection
          </text>
          <rect
            class="art-button"
            x="195"
            y="139"
            width="112"
            height="20"
            rx="4"
          />
          <text class="art-small" x="251" y="153" text-anchor="middle">
            Saved to Slate
          </text>
          <path class="art-stroke" d="M153 120h23m-6-5 6 5-6 5" />
        </svg>
      </figure>
      <div class="step-copy">
        <h2>
          <span aria-hidden="true">4.</span> Add the Chrome extension
        </h2>
        <p>Save useful things from your browser directly into Slate.</p>
        <p class="extension-note">Optional companion to Slate Desktop.</p>
        {chromeUrl ? (
          <a
            class="extension-link"
            href={chromeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get Chrome extension <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <button class="extension-link" type="button" disabled>
            Get Chrome extension
          </button>
        )}
      </div>
    </li>
  </ol>
</section>

<style>
  .install-guide {
    margin-block: 24px 12px;
  }
  .install-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }
  .install-step {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }
  figure {
    flex: none;
    margin: 0;
    overflow: hidden;
  }
  .downloads-art {
    background: #f3eadc;
    --folder-back: #d8b770;
    --folder-front: #ead29f;
  }
  .protection-art {
    background: #e8eef8;
    --art-tint: #d9e4f4;
  }
  .setup-art {
    background: #e7efe5;
    --art-tint: #d5e6d1;
  }
  .extension-art {
    background: #f0e8f5;
    --art-tint: #e3d5ee;
  }
  :global([data-theme='dark']) .downloads-art {
    background: #302b24;
    --folder-back: #6e5833;
    --folder-front: #56472e;
  }
  :global([data-theme='dark']) .protection-art {
    background: #252e3b;
    --art-tint: #33435a;
  }
  :global([data-theme='dark']) .setup-art {
    background: #26332b;
    --art-tint: #38513e;
  }
  :global([data-theme='dark']) .extension-art {
    background: #312739;
    --art-tint: #4b365b;
  }
  .extension-popup {
    stroke: var(--line);
  }
  svg {
    display: block;
    width: 100%;
    height: 184px;
    color: var(--ink);
  }
  .folder-back {
    fill: var(--folder-back);
  }
  .folder-front {
    fill: var(--folder-front);
  }
  .art-surface {
    fill: var(--surface);
  }
  .art-line {
    stroke: var(--line);
  }
  .art-stroke {
    stroke: var(--ink);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .shield,
  .complete,
  .art-button {
    fill: var(--art-tint);
  }
  .shield {
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .art-pointer {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .art-label {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 550;
  }
  .art-file {
    fill: var(--ink);
    font-size: 9px;
    font-weight: 550;
  }
  .art-small {
    fill: var(--muted);
    font-size: 10px;
  }
  .art-underline {
    text-decoration: underline;
  }
  .step-copy {
    flex: 1;
    padding: 16px 16px 14px;
  }
  h2 {
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.035em;
    min-height: 2.5em;
  }
  h2 span {
    margin-right: 4px;
    color: var(--muted);
  }
  .step-copy p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .step-copy .extension-note {
    margin-top: 6px;
    font-size: 12px;
  }
  .extension-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 13px;
  }
  strong {
    color: var(--ink);
    font-weight: 550;
  }
  @media (max-width: 1023px) {
    .install-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }
  @media (min-width: 761px) and (max-height: 760px) {
    .install-guide {
      margin-top: 16px;
    }
    svg {
      height: 164px;
    }
  }
  @media (max-width: 600px) {
    .install-steps {
      grid-template-columns: 1fr;
      gap: 24px;
      max-width: 420px;
      margin-inline: auto;
    }
    svg {
      height: auto;
      max-height: 220px;
    }
    .install-guide {
      margin-block: 24px 20px;
    }
    h2 {
      min-height: 0;
    }
  }
</style>
