---
import Icon from './Icon.astro';
import PlatformLogo from './PlatformLogo.astro';
import { release, downloadUrl } from '../data/releases';
const chromeUrl = downloadUrl(release.downloads.chrome);
---

<section
  id="download"
  class="download-section"
  aria-labelledby="download-title"
>
  <div class="shell">
    <div class="download-heading">
      <div>
        <h2 id="download-title">Get Slate</h2>
      </div>
      <p>v{release.version} · Windows 11</p>
    </div>
    <div class="get-slate-cards">
      <article class="get-slate-card" aria-labelledby="windows-title">
        <div class="card-heading">
          <span class="card-icon">
            <PlatformLogo platform="windows" />
          </span>
          <h3 id="windows-title">Slate for Windows</h3>
        </div>
        <p class="card-description">
          Your personal library, stored locally on your PC.
        </p>
        <div class="card-action">
          <a class="button primary" href="/download/windows/?start=1">
            <PlatformLogo platform="windows" /> Download for Windows
          </a>
        </div>
      </article>
      <article class="get-slate-card" aria-labelledby="chrome-title">
        <div class="card-heading">
          <span class="card-icon">
            <Icon name="globe" />
          </span>
          <h3 id="chrome-title">Chrome Extension</h3>
        </div>
        <p class="card-description">
          Save content from your browser straight into Slate.
        </p>
        <p class="capture-note">
          Browser capture requires the Slate desktop app.
        </p>
        <div class="card-action">
          {chromeUrl ? (
            <a class="button secondary" href={chromeUrl}>
              Add to Chrome <Icon name="arrow" />
            </a>
          ) : (
            <button
              class="button secondary"
              type="button"
              disabled
              title="Chrome installation unavailable"
            >
              Add to Chrome <Icon name="arrow" />
            </button>
          )}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .get-slate-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .get-slate-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
  }
  .card-heading {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: var(--radius);
    background: var(--soft);
  }
  h3 {
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.03em;
  }
  .card-description {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .capture-note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .card-action {
    margin-top: auto;
    padding-top: 20px;
  }
  @media (max-width: 700px) {
    .get-slate-cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .get-slate-card {
      padding: 22px;
    }
    h3 {
      font-size: 20px;
    }
  }
</style>
