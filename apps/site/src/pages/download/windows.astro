---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WindowsDownloadOptions from '../../components/WindowsDownloadOptions.astro';
import WindowsInstallGuide from '../../components/WindowsInstallGuide.astro';
import { release } from '../../data/releases';
---

<BaseLayout
  title="Download Slate for Windows | Slate"
  description="Just a few steps left. Download Slate for Windows and follow a simple installation guide."
  home={false}
  showFooter={false}
>
  <article class="windows-guide shell" data-windows-download-guide>
    <header class="guide-intro">
      <h1>Thanks for downloading Slate!</h1>
      <p class="guide-lead">Just a few steps left.</p>
      <p
        class="download-status"
        data-download-status
        role="status"
        aria-live="polite"
      >
        Choose your Windows installer to get started.
      </p>
      <a class="manual-fallback" href="#manual-installers" data-manual-download>
        Didn't start? Download manually
      </a>
    </header>
    <WindowsInstallGuide />
    <details class="download-options" data-download-options>
      <summary>Downloads &amp; verification</summary>
      <div class="optional-content" id="manual-installers" tabindex="-1">
        <h2>Choose your Windows installer</h2>
        <p class="architecture-help">
          Windows 11 · Slate {release.version}. Check{' '}
          <strong>Settings → System → About → System type</strong>: x64 for
          Intel or AMD, ARM64 for an ARM processor.
        </p>
        <WindowsDownloadOptions />
      </div>
    </details>
  </article>
</BaseLayout>

<script>
  import { initializeWindowsDownloadGuide } from '../../scripts/windowsDownloadGuide';
  const root = document.querySelector<HTMLElement>(
    '[data-windows-download-guide]',
  );
  if (root) void initializeWindowsDownloadGuide(root, navigator, window);
</script>

<style>
  .windows-guide {
    position: relative;
    isolation: isolate;
    max-width: 1200px;
    padding-block: 26px 48px;
  }
  .windows-guide::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--line) 0.7px, transparent 0.7px);
    background-size: 20px 20px;
    mask-image: linear-gradient(transparent, #000 20%, #000 70%, transparent);
    opacity: 0.4;
  }
  .guide-intro {
    text-align: center;
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.055em;
  }
  .guide-lead {
    margin-top: 8px;
    font-size: clamp(18px, 2vw, 22px);
    letter-spacing: -0.025em;
  }
  .download-status {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .manual-fallback {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .download-options {
    max-width: 920px;
    margin-inline: auto;
  }
  .download-options > summary {
    width: fit-content;
    margin-inline: auto;
    padding: 10px;
    color: var(--muted);
    cursor: pointer;
    font-size: 13px;
  }
  .optional-content {
    margin-top: 14px;
    padding: clamp(18px, 3vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--page);
    scroll-margin-top: 100px;
  }
  h2 {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .architecture-help {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  @media (min-width: 761px) and (max-height: 760px) {
    .windows-guide {
      padding-block: 14px 32px;
    }
  }
  @media (max-width: 760px) {
    .windows-guide {
      padding-top: 24px;
    }
    h1 {
      max-width: 520px;
      margin-inline: auto;
    }
    .download-status {
      max-width: 280px;
      margin-inline: auto;
    }
  }
</style>
